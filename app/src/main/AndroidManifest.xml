<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Jalon 1 : aucune permission. Aucune donnée ne quitte le téléphone, pas de sauvegarde cloud. -->
    <application
        android:name=".AssistantApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Assistant"
        tools:targetApi="35">

        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Écran de saisie ouvert par le widget : tâche à part, absent des applis récentes,
             pas recréé quand on plie ou déplie le téléphone. -->
        <activity
            android:name=".ui.quickcapture.QuickCaptureActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="fr.bastien.assistant.capture"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|density|uiMode"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize"
            android:theme="@style/Theme.Assistant.Capture" />

        <receiver
            android:name=".widget.AssistantWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/assistant_widget_info" />
        </receiver>
    </application>

    <!-- Permet de lancer la reconnaissance vocale du téléphone (Android 11 et plus). -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>
</manifest>
