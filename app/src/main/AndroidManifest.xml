<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Réseau : uniquement pour la synchro avec Microsoft To Do, après enregistrement local.
         Pas de sauvegarde cloud Android. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".AssistantApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Assistant"
        tools:targetApi="35">

        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Écran de saisie ouvert par le widget : tâche à part, absent des applis récentes,
             pas recréé quand on plie ou déplie le téléphone. Il peut s'afficher par-dessus
             l'écran verrouillé : il ne montre jamais les captures existantes. -->
        <activity
            android:name=".ui.quickcapture.QuickCaptureActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:taskAffinity="fr.bastien.assistant.capture"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|density|uiMode"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize"
            android:theme="@style/Theme.Assistant.Capture" />

        <!-- Porte d'entrée « par défaut » de l'appli (catégorie INFO, sans icône en plus) :
             c'est elle qu'Android ouvre quand un réglage lance « Assistant » sans préciser d'écran,
             comme le double appui sur la touche latérale Samsung. Ouvre directement la saisie.
             L'icône Assistant, elle, ouvre toujours l'historique. -->
        <activity-alias
            android:name=".Noter"
            android:exported="true"
            android:icon="@mipmap/ic_note_launcher"
            android:label="@string/note_name"
            android:roundIcon="@mipmap/ic_note_launcher"
            android:targetActivity=".ui.quickcapture.QuickCaptureActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.INFO" />
            </intent-filter>
        </activity-alias>

        <!-- Tuile « Noter » des réglages rapides. -->
        <service
            android:name=".widget.CaptureTileService"
            android:exported="true"
            android:icon="@drawable/ic_note"
            android:label="@string/note_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".widget.AssistantWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/assistant_widget_info" />
        </receiver>

        <!-- WorkManager démarre au premier envoi, pas à l'ouverture : l'écran de saisie reste immédiat. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

    <!-- Permet de lancer la reconnaissance vocale du téléphone (Android 11 et plus). -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>
</manifest>
